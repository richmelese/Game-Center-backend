# ---- Server
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://telegame:telegame@localhost:5434/telegame?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Admin account created by `npm run seed`
ADMIN_EMAIL=admin@lemattech.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Login (OTP). OTP_DEV_ECHO=true returns the code in the API response (development only!)
OTP_DEV_ECHO=true

# ---- Pricing & revenue sharing (proposal section 3)
PRICES_INCLUDE_VAT=true
VAT_RATE=0.15
OTHER_TAX_RATE=0
PARTNER_SHARE=0.70

# ---- Demo / trial games (proposal section 3.3)
DEMO_PLAYS_PER_DAY=3
DEMO_SECONDS=180

# ---- Coins (proposal section 2.2, steps 7-8)
# Starting values only: used the first time the server runs. After that, change them in
# Admin -> Coin settings (e.g. "5 coins every 2 minutes"); editing these lines has no effect.
COINS_PER_MINUTE=2
MAX_COINS_PER_SESSION=60
MAX_COINS_PER_DAY=200
COINS_PER_ETB=100
MIN_REDEEM_COINS=100

# ---- telebirr integration (H5 C2B web checkout; needs credentials below)
PAYMENT_PROVIDER=telebirr
# PAYOUT_PROVIDER=mock    -> coin conversions are paid instantly (simulated)
# PAYOUT_PROVIDER=manual  -> conversions wait for an admin to disburse and mark them paid
PAYOUT_PROVIDER=mock
PUBLIC_API_URL=http://localhost:4000

TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_SHORT_CODE=
# PEM keys; use \n for line breaks when stored on one line
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=

# ---- Security
# NODE_ENV=production refuses to start with a simulated payout provider, OTP_DEV_ECHO,
# the default admin password, or a localhost FRONTEND_URL.
NODE_ENV=development
# Admin sessions expire faster than customer sessions
ADMIN_JWT_EXPIRES_IN=8h
# Number of reverse proxies in front of the API (0 when the API is reached directly)
TRUST_PROXY_HOPS=0

# ---- Hosted HTML5 games (Ethio Telecom Games Portal). Game links and pictures are
# stored as paths and served from this address; change it when the games move.
GAMES_BASE_URL=http://telegames.196.189.126.55.nip.io
